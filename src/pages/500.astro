---
import "../styles/global.css";
import "../styles/layout.css";
import "../styles/components.css";
import "../styles/responsive.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Server Error | Convertly</title>
    <meta
      name="description"
      content="Convertly is currently experiencing a temporary server error. Please try again or return to the homepage."
    />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
  </head>
  <body>
    <main class="legal-page">
      <div class="legal-shell">
        <article class="legal-card error-card">
          <p class="eyebrow">500 Error</p>
          <h1>Something went wrong</h1>
          <p>
            We are experiencing a temporary issue while loading this page.
          </p>
          <p>
            Please try again in a moment or return to the <a href="/">USD to INR converter</a>.
          </p>
        </article>
      </div>
    </main>
  </body>
</html>
