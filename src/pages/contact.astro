---
import "../styles/global.css";
import "../styles/layout.css";
import "../styles/components.css";
import "../styles/responsive.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contact Us | Convertly</title>
    <meta
      name="description"
      content="Contact Convertly for support, feedback, or questions about the USD to INR converter or live exchange-rate data."
    />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href="https://convertly.app/contact" />
  </head>
  <body>
    <main class="legal-page">
      <div class="legal-shell">
        <a href="/" class="back-link">← Back to converter</a>
        <article class="legal-card">
          <p class="eyebrow">Contact us</p>
          <h1>Contact Convertly</h1>
          <p>We’d love to hear from you.</p>
          <p>
            If you have questions about USD to INR conversion, live exchange-rate accuracy, product
            issues, or business opportunities, please get in touch.
          </p>

          <div class="contact-box">
            <p><strong>Email:</strong> <a href="mailto:support@convertly.app">support@convertly.app</a></p>
            <p><strong>Support:</strong> We usually respond within 1–3 business days.</p>
          </div>
        </article>
      </div>
    </main>
  </body>
</html>
