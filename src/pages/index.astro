---
import ConverterPage from "../components/ConverterPage";
import "../styles/global.css";
import "../styles/layout.css";
import "../styles/components.css";
import "../styles/responsive.css";

const currentDate = new Date().toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>USD to INR Converter | Live Exchange Rate & Calculator</title>
    <meta
      name="description"
      content="Convert USD to INR with live exchange rates. Use our free USD to INR calculator for fast and accurate US Dollar to Indian Rupee conversion."
    />
    <meta
      name="keywords"
      content="USD to INR, usd to inr, usd to rupees, convert usd to inr, usd to indian rupees, 100 usd to inr, 500 usd to inr, usd to inr rate, usd to inr live, dollar to inr, dollars to rupees, dollars to inr, usd inr calculator, usd to rupees converter"
    />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://convertly.app/" />
    <meta property="og:title" content="USD to INR Converter | Live Exchange Rate & Calculator" />
    <meta
      property="og:description"
      content="Convert USD to INR with live exchange rates. Accurate and real-time US Dollar to Indian Rupee conversion for daily use."
    />
    <meta property="og:image" content="https://convertly.app/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:site_name" content="Convertly" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://convertly.app/" />
    <meta property="twitter:title" content="USD to INR Converter | Live Exchange Rate & Calculator" />
    <meta
      property="twitter:description"
      content="Convert USD to INR with live exchange rates using our fast and reliable calculator."
    />
    <meta property="twitter:image" content="https://convertly.app/og-image.png" />

    <link rel="canonical" href="https://convertly.app/" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="author" content="Convertly" />
    <meta name="language" content="English" />
    <meta name="revisit-after" content="7 days" />

    <!-- FAQ Schema Markup - JSON-LD -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "How to convert INR to USD?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "To convert INR to USD, divide the INR amount by the current USD to INR exchange rate. For example, if 1 USD = 83 INR, then 8,300 INR = 100 USD. You can use our converter's swap feature to instantly convert INR to USD with live exchange rates."
            }
          },
          {
            "@type": "Question",
            "name": "What if 1 USD is equal to 1 INR?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "If 1 USD were equal to 1 INR (hypothetically), it would represent a massive change in the Indian Rupee's value. Currently, 1 USD is worth approximately 83 INR. Such parity would mean the INR strengthened significantly against the US Dollar, which would have major economic implications for India's imports, exports, and inflation."
            }
          },
          {
            "@type": "Question",
            "name": "How much is $1000 dollars in India currency?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "$1000 USD is equal to approximately 83,000 INR based on current exchange rates (1 USD ≈ 83 INR). The exact amount fluctuates daily based on market conditions. Use our live converter to get the most accurate USD to INR conversion for $1000 or any amount."
            }
          },
          {
            "@type": "Question",
            "name": "How much is $1 US in India today?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "$1 USD is worth approximately 83 Indian Rupees today. The exact value changes throughout the day due to market fluctuations. Check our live USD to INR converter for the current real-time exchange rate updated multiple times per day."
            }
          },
          {
            "@type": "Question",
            "name": "How much is $100 USD to INR?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "$100 USD equals approximately 8,300 Indian Rupees based on the current USD to INR exchange rate. This amount varies daily as the exchange rate fluctuates. Our converter provides instant and accurate calculations for $100 or any amount you want to convert."
            }
          },
          {
            "@type": "Question",
            "name": "How do I convert US dollars to Indian rupees?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "To convert US dollars to Indian rupees, multiply the USD amount by the current USD to INR exchange rate. For example: $100 × 83 = ₹8,300. Our free online converter automates this process and updates the rate in real-time. Simply enter the USD amount and get instant INR conversion with live rates."
            }
          },
          {
            "@type": "Question",
            "name": "How to convert dollar to INR formula?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The USD to INR conversion formula is: INR Amount = USD Amount × Current USD to INR Exchange Rate. For example, if you want to convert $50 and the rate is 83, the formula is: 50 × 83 = 4,150 INR. The exchange rate changes daily, so always use the current live rate for accurate conversions."
            }
          },
          {
            "@type": "Question",
            "name": "How can we convert USD to INR?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "There are several ways to convert USD to INR: (1) Use an online converter like Convertly for real-time rates, (2) Use the formula: USD × Current Exchange Rate = INR, (3) Check banking apps and exchange rate platforms, (4) Visit banks or money exchange counters for official rates. Our converter provides the fastest and most accurate live USD to INR conversion."
            }
          },
          {
            "@type": "Question",
            "name": "Why is USD-INR falling?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The USD to INR exchange rate falls when the Indian Rupee strengthens against the US Dollar. This can happen due to factors like stronger Indian economic growth, higher interest rates in India, increased foreign investment in India, lower US interest rates, or global economic conditions favoring emerging markets. The exchange rate is determined by supply and demand in currency markets and changes multiple times daily."
            }
          }
        ]
      }
    </script>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "Convertly - USD to INR Converter",
        "description": "Free online USD to INR converter with live exchange rates and historical charts.",
        "url": "https://convertly.app",
        "applicationCategory": "FinanceApplication",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        }
      }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://api.frankfurter.app" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <ConverterPage client:load />
  </body>
</html>
