---
import ConverterPage from "../components/ConverterPage";
import "../styles/global.css";
import "../styles/layout.css";
import "../styles/components.css";
import "../styles/responsive.css";

const currentDate = new Date().toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>USD to INR Converter | Live Exchange Rate & Calculator</title>
    <meta
      name="description"
      content="Convert USD to INR with live exchange rates. Use our free USD to INR calculator for fast and accurate US Dollar to Indian Rupee conversion."
    />
    <meta
      name="keywords"
      content="USD to INR, usd to inr, usd to rupees, convert usd to inr, usd to indian rupees, 100 usd to inr, 500 usd to inr, usd to inr rate, usd to inr live, dollar to inr, dollars to rupees, dollars to inr, usd inr calculator, usd to rupees converter"
    />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://convertly.app/" />
    <meta property="og:title" content="USD to INR Converter | Live Exchange Rate & Calculator" />
    <meta
      property="og:description"
      content="Convert USD to INR with live exchange rates. Accurate and real-time US Dollar to Indian Rupee conversion for daily use."
    />
    <meta property="og:image" content="https://convertly.app/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:site_name" content="Convertly" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://convertly.app/" />
    <meta property="twitter:title" content="USD to INR Converter | Live Exchange Rate & Calculator" />
    <meta
      property="twitter:description"
      content="Convert USD to INR with live exchange rates using our fast and reliable calculator."
    />
    <meta property="twitter:image" content="https://convertly.app/og-image.png" />

    <link rel="canonical" href="https://convertly.app/" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="author" content="Convertly" />
    <meta name="language" content="English" />
    <meta name="revisit-after" content="7 days" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "Convertly - USD to INR Converter",
        "description": "Free online USD to INR converter with live exchange rates and historical charts.",
        "url": "https://convertly.app",
        "applicationCategory": "FinanceApplication",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        }
      }
    </script>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "How much is 1 USD to INR?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "1 USD is worth around a current market value in INR. Use our live calculator for the most current USD to INR rate."
            }
          },
          {
            "@type": "Question",
            "name": "What is 100 USD to INR?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "100 USD is converted to Indian Rupees using the live USD to INR exchange rate shown above."
            }
          },
          {
            "@type": "Question",
            "name": "What is the USD to INR exchange rate today?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The USD to INR exchange rate changes throughout the day due to market conditions. Our tool refreshes the live value automatically."
            }
          }
        ]
      }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://api.frankfurter.app" />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <ConverterPage client:load />
  </body>
</html>
